join pg_namespace n on n.oid = c.relnamespace
where n.nspname='public' and c.relkind='r'
order by 1,2;

-- =========================================
-- 1) Conciliar nomes PT → EN
--    - Se já existem as duas versões (PT e EN): migra dados PT→EN e dropa PT
--    - Se só existe PT: renomeia para EN
-- =========================================
do $$
begin
  -- ===== POINTS =====
  if to_regclass('public."Pontos"') is not null and to_regclass('public.points') is not null then
    -- Migrar dados da PT -> EN (ajuste os campos se sua "Pontos" tiver diferença)
    execute '
      insert into public.points (id,nome,categoria,endereco,bairro,lat,lng,horario,fonte,verificado,atualizado_em)
      select id,nome,categoria,endereco,bairro,lat,lng,horario,fonte,coalesce(verificado,false),atualizado_em
      from public."Pontos"
      on conflict (id) do nothing
    ';
    execute 'drop table public."Pontos" cascade';
  elsif to_regclass('public."Pontos"') is not null and to_regclass('public.points') is null then
    execute 'alter table public."Pontos" rename to points';
  end if;

  -- ===== SUGGESTIONS =====
  if to_regclass('public."Sugestões"') is not null and to_regclass('public.suggestions') is not null then
    execute '
      insert into public.suggestions
        (nome,categoria,endereco,bairro,lat,lng,horario,telefone,observacoes,status,created_at,created_by)
      select
        nome,categoria,endereco,bairro,lat,lng,horario,telefone,observacoes,coalesce(status,''pendente''),created_at,created_by
      from public."Sugestões"
    ';
    execute 'drop table public."Sugestões" cascade';
  elsif to_regclass('public."Sugestões"') is not null and to_regclass('public.suggestions') is null then
    execute 'alter table public."Sugestões" rename to suggestions';
  end if;
end
$$;

-- =========================================
-- 2) Garantir tipos/geom em public.points
--    (se geom existir e for preciso alterar lat/lng, dropa e recria)
-- =========================================
do $$
declare
  lat_ok boolean := false;
  lng_ok boolean := false;
  geom_exists boolean := false;
begin
  if to_regclass('public.points') is null then
    raise notice 'Tabela public.points não encontrada (nada a fazer neste bloco).';
    return;
  end if;

  select (data_type = 'double precision') into lat_ok
    from information_schema.columns
    where table_schema='public' and table_name='points' and column_name='lat';

  select (data_type = 'double precision') into lng_ok
    from information_schema.columns
    where table_schema='public' and table_name='points' and column_name='lng';

  select exists(
    select 1 from information_schema.columns
    where table_schema='public' and table_name='points' and column_name='geom'
  ) into geom_exists;

  if (not lat_ok or not lng_ok) and geom_exists then
    execute 'alter table public.points drop column geom';
    geom_exists := false;
  end if;

  if not lat_ok then
    execute 'alter table public.points alter column lat type double precision using lat::double precision';
  end if;
  if not lng_ok then
    execute 'alter table public.points alter column lng type double precision using lng::double precision';
  end if;

  if not geom_exists then
    execute $sql$
      alter table public.points
      add column geom geography(Point, 4326)
      generated always as (ST_SetSRID(ST_MakePoint(lng, lat), 4326)::geography) stored
    $sql$;
  end if;
end
$$;

