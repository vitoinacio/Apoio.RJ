-- 2) ADMIN: usuário/senha fixos, guardados no banco (hash)
--    Usaremos essa tabela para autenticar na sua rota /admin/login
create table if not exists public.admin_users (
  id             uuid primary key default gen_random_uuid(),
  username       text not null unique,
  password_hash  text not null,
  role           text not null default 'admin',
  is_active      boolean not null default true,
  created_at     timestamptz not null default now(),
  last_login_at  timestamptz
);

-- índice útil para login
create index if not exists admin_users_username_idx on public.admin_users (username);

-- seed do admin fixo
-- SUBSTITUA o segundo parâmetro de crypt() por um gen_salt('bf', 10) novo se quiser outro custo/fresh salt
-- Isso grava a senha "AD1418" com bcrypt.
insert into public.admin_users (username, password_hash, role, is_active)
values (
  'AD_001',
  crypt('AD1418', gen_salt('bf', 10)),
  'admin',
  true
)
on conflict (username) do nothing;

-- (opcional) função helper para checar credenciais (pode usar em testes SQL)
create or replace function public.admin_check_credentials(p_username text, p_password text)
returns boolean
language sql
stable
as $$
  select exists(
    select 1
    from public.admin_users au
    where au.username = p_username
      and au.is_active = true
      and au.password_hash = crypt(p_password, au.password_hash)
  );
$$;

-- (opcional) registrar último login
create or replace function public.admin_touch_last_login(p_username text)
returns void
language sql
volatile
as $$
  update public.admin_users
     set last_login_at = now()
   where username = p_username
     and is_active = true;
$$;

-- 3) Tabela de pontos aprovados (produção)
create table if not exists public.points (
  id            text primary key,
  nome          text not null,
  categoria     text not null check (categoria in ('seguranca','educacao','saude','assistencia','internet')),
  endereco      text not null,
  bairro        text,
  lat           double precision not null check (lat between -90 and 90),
  lng           double precision not null check (lng between -180 and 180),
  horario       text,
  fonte         text,
  verificado    boolean not null default false,
  atualizado_em date,
  -- geometria derivada (geography) para consultas por raio (metros)
  geom          geography(Point, 4326)
    generated always as (ST_SetSRID(ST_MakePoint(lng, lat), 4326)::geography) stored,
  inserted_at   timestamptz not null default now(),
  updated_at    timestamptz not null default now()
);

-- Índices (geo + busca texto)
create index if not exists points_geom_gix       on public.points using gist (geom);
create index if not exists points_categoria_idx  on public.points (categoria);
create index if not exists points_text_trgm      on public.points using gin (
  (nome || ' ' || coalesce(endereco,'') || ' ' || coalesce(bairro,'')) gin_trgm_ops
);

-- (opcional) evitar duplicatas óbvias (mesmo nome nas mesmas coords)
-- create unique index if not exists points_uniq_name_loc on public.points (nome, lat, lng);

-- Trigger updated_at
create or replace function public.set_updated_at()
returns trigger language plpgsql as $$
begin
  new.updated_at = now();
  return new;
end $$;

drop trigger if exists points_set_updated_at on public.points;
create trigger points_set_updated_at
before update on public.points
for each row execute function public.set_updated_at();

-- RLS: público pode LER points (para listar/pesquisar no site)
alter table public.points enable row level security;

drop policy if exists "points_public_read" on public.points;
create policy "points_public_read" on public.points
for select using (true);
-- (se quiser expor só verificados no futuro, troque por: using (verificado = true))

-- (admin via servidor/service_role faz INSERT/UPDATE/DELETE em points; não abrimos isso ao público)

-- 4) Tabela de sugestões (fila pública de envios)
create table if not exists public.suggestions (
  id           bigserial primary key,
  nome         text not null,
  categoria    text,
  endereco     text not null,
  bairro       text,
  lat          double precision not null,
  lng          double precision not null,
  horario      text,
  telefone     text,
  observacoes  text,
  status       text not null default 'pendente' check (status in ('pendente','aprovado','rejeitado')),
  created_at   timestamptz not null default now(),
  created_by   uuid references auth.users(id)
);

alter table public.suggestions enable row level security;

-- Qualquer visitante pode INSERIR (sugerir ponto)
drop policy if exists "suggestions_anyone_insert" on public.suggestions;
create policy "suggestions_anyone_insert" on public.suggestions
for insert with check (true);

-- Não criamos políticas de SELECT/UPDATE/DELETE para o público:
-- só o admin (via servidor/service_role) enxerga e modera a fila.

